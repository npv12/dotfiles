{
  "plugin": [
    "@npv12/opencode-quota",
    "@npv12/opencode-tps",
    "@npv12/opencode-context-sidebar",
    "@npv12/opencode-recap",
    ["opencode-mini-session", { "keybind": "<leader>d", "freshKeybind": "<leader>f" }],
  ],
  "scroll_speed": 2,
  "scroll_acceleration": {
    "enabled": true,
  },
  "attention": {
    "enabled": true,
  },
  "keybinds": {
    "prompt_stash": "<leader>p",
    "prompt_stash_pop": "<leader>o",
    "prompt_stash_list": "<leader>i",
  },
}
