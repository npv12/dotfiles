{
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true,
    "grouping": "auto",
    "verbosity": "low",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "scope": "global",
    "indicators": "status"
  },
  "attention": {
    "enabled": true,
    "notifications": true
  },
  "keybinds": {
    "prompt.stash": "<leader>p",
    "prompt.stash.pop": "<leader>o",
    "prompt.stash.list": "<leader>i"
  },
  "plugins": [
    "@npv12/opencode-context-sidebar",
    "@npv12/opencode-recap",
    "opencode-quick-quote",
    "-opencode.sidebar.context"
  ],
  "scroll": {
    "acceleration": true,
    "speed": 3.5
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "terminal": {
    "copy": "manual"
  },
  "debug": {
    "devtools": false
  }
}
