{
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true,
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "scope": "global"
  },
  "attention": {
    "enabled": true
  },
  "keybinds": {
    "prompt.stash": "<leader>p",
    "prompt.stash.pop": "<leader>o",
    "prompt.stash.list": "<leader>i"
  },
  "plugins": [
    "@npv12/opencode-context-sidebar",
    "@npv12/opencode-mini-session",
    "@npv12/opencode-recap",
    "@npv12/opencode-tps",
    "@npv12/opencode-quota",
    "@npv12/opencode-footer",
    "-opencode.sidebar.context",
    "-opencode.prompt.footer"
  ],
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "terminal": {
    "copy": "manual"
  }
}
