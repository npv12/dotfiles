{
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "scope": "global"
  },
  "attention": {
    "enabled": true
  },
  "keybinds": {
    "prompt_stash": "<leader>p",
    "prompt_stash_pop": "<leader>o",
    "prompt_stash_list": "<leader>i"
  },
  "plugins": [
    "@npv12/opencode-context-sidebar",
    "@npv12/opencode-mini-session",
    "@npv12/opencode-recap",
    "@npv12/opencode-tps",
    "@npv12/opencode-quota",
    "@npv12/opencode-footer",
    "-opencode.sidebar.context",
    "-opencode.prompt.footer"
  ]
}
