{
	"$schema": "https://opencode.ai/config.json",
	// TODO(plugins): port V1 plugins to the V2 plugin API before re-enabling.
	// "plugins": ["@npv12/opencode-memory-md"],
	"default_agent": "build",
	"agents": {
		"plan": {
			"hidden": true,
			"mode": "all",
		},
		"build": {
			"color": "#a6e3a1",
		},
		"explore": {
			"color": "#f9e2af",
			"model": "opencode-go/mimo-v2.5#max",
		},
	},
