#!/usr/bin/env bash
# tmux-session-manager
# Dependencies: fzf, zoxide
# Usage: bind in .tmux.conf with:
#   bind s display-popup -E -w 80% -h 60% "tmux-session-manager"

set -eu

# ── helpers ──────────────────────────────────────────────────────────────────

session_exists() { tmux has-session -t "$1" 2>/dev/null; }

switch_to() {
  local name="$1"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

# ── build candidate list ──────────────────────────────────────────────────────
# Format: <tag> <display> <value>
#   tag   → [session] or [dir]
#   value → session name or directory path

candidates() {
  local current_session="" sessions=""
  current_session=$(tmux display-message -p '#S' 2>/dev/null || true)
  sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)

  # Active tmux sessions first
  if [ -n "$sessions" ]; then
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      local current=""
      [ "$s" = "$current_session" ] && current=" (current)"
      printf "\033[1;32m[session]\033[0m  %-30s%s\n" "$s" "$current" || return 0
    done <<< "$sessions"
  fi

  local session_list=$'\n'"$sessions"$'\n'

  # Zoxide directories
  zoxide query --list 2>/dev/null | while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    local clean="${dir%/}"
    local name="${clean##*/}"
    # dim if session already exists for this dir name
    if [[ "$session_list" == *$'\n'"$name"$'\n'* ]]; then
      printf "\033[2;34m[dir]\033[0m      \033[2m%-30s\033[0m  %s\n" "$name" "$dir" || exit 0
    else
      printf "\033[1;34m[dir]\033[0m      %-30s  %s\n" "$name" "$dir" || exit 0
    fi
  done
}

# ── kill helper (called inline by fzf) ───────────────────────────────────────

do_kill() {
  # $1 = selected line from fzf
  local pick="$1"
  local clean_pick
  clean_pick=$(echo "$pick" | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g')
  local name=""
  if echo "$clean_pick" | grep -q '^\[session\]'; then
    name=$(echo "$clean_pick" | sed -E 's|^\[session\][[:space:]]+([^ ]+).*|\1|')
  fi
  [ -n "$name" ] && tmux kill-session -t "$name" 2>/dev/null || true
}

# ── main ──────────────────────────────────────────────────────────────────────

main() {
  local selected
  set +o pipefail
  selected=$(
    candidates 2>/dev/null \
      | fzf \
          --ansi \
          --reverse \
          --prompt="  session/dir > " \
          --header="ENTER: switch/create  |  CTRL-D: delete sessions  |  CTRL-C: cancel" \
          --header-first \
          --color="header:italic:#74c7ec,prompt:#74c7ec" \
          --bind "ctrl-d:execute(bash \"$0\" --kill {})+reload(bash \"$0\" --list)" \
          --print-query \
          --expect=enter \
          --no-multi
  ) || true

  # fzf --print-query outputs: line1=query, line2=key, line3=selection
  local query key pick
  query=$(echo "$selected" | sed -n '1p')
  key=$(echo "$selected"   | sed -n '2p')
  pick=$(echo "$selected"  | sed -n '3p')

  # If Enter was not pressed (e.g. Esc or Ctrl-C), exit cleanly
  [ "$key" != "enter" ] && exit 0

  # Determine what to act on
  local target=""
  local target_dir=""

  if [ -n "$pick" ]; then
    # User selected an existing entry
    local clean_pick
    clean_pick=$(echo "$pick" | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g')
    if echo "$clean_pick" | grep -q '^\[session\]'; then
      # Extract session name
      target=$(echo "$clean_pick" | sed -E 's|^\[session\][[:space:]]+([^ ]+).*|\1|')
    else
      # It's a dir entry - extract directory path (starts with /)
      target_dir=$(echo "$clean_pick" | sed -E 's|^.*[[:space:]](/[^[:space:]].*)$|\1|')
      target="${target_dir%/}"
      target="${target##*/}"
    fi
  elif [ -n "$query" ]; then
    # Free-text: treat as new session name
    target="$query"
  else
    exit 0
  fi

  [ -z "$target" ] && exit 0

  # Create session if it doesn't exist
  if ! session_exists "$target"; then
    if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
      tmux new-session -d -s "$target" -c "$target_dir"
      # Inform zoxide about this directory
      zoxide add "$target_dir" 2>/dev/null || true
    else
      tmux new-session -d -s "$target"
    fi
  fi

  switch_to "$target"
}

# ── entry point ───────────────────────────────────────────────────────────────

if [ "${1:-}" = "--kill" ]; then
  do_kill "${2:-}"
elif [ "${1:-}" = "--list" ]; then
  candidates
else
  main
fi
