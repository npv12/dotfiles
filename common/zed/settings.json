{
  "proxy": "",
  "markdown_preview": {
    "font_family": "Inter Variable",
    "code_font_family": "JetBrainsMono Nerd Font Mono"
  },
  "disable_ai": false,
  "command_aliases": {
    "gd": "git::Diff",
    "gb": "git::Branch",
    "gbd": "git::DiffBranch",
    "gp": "git::Push",
    "gcp": "git::CreatePullRequest",
    "tsd": "editor::ToggleSplitDiff",
    "gg": "git_graph::Open"
  },
  "use_smartcase_search": true,
  "search": {
    "button": false
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "eager",
    "provider": "zed"
  },
  "ui_font_family": "Inter Variable",
  "buffer_font_weight": 500,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "language_models": {
    "opencode": {
      "show_go_models": false,
      "show_zen_models": true
    }
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "zed.dev",
        "raw.githubusercontent.com"
      ]
    },
    "default_profile": "write",
    "flexible": false,
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-5"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-haiku-4-5",
        "enable_thinking": false
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "sort_by": "path",
    "group_by": "staging",
    "dock": "left",
    "tree_view": true
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Warm Charmed Icons",
    "dark": "Soft Charmed Icons"
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "terminal": {
    "cursor_shape": "underline",
    "font_family": "MesloLGS NF",
    "font_size": 14,
    "line_height": "standard"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 17,
  "buffer_font_size": 16,
  "completion_menu_item_kind": "symbol",
  "theme": {
    "mode": "system",
    "light": "Matcha Haze Light",
    "dark": "Matcha Haze Dark"
  }
}
