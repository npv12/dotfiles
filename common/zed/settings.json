{
  "command_aliases": {
    "gd": "git::Diff",
    "gb": "git::Branch",
    "gbd": "git::BranchDiff",
    "gp": "git::Push",
    "gcp": "git::CreatePullRequest",
    "tsd": "editor::ToggleSplitDiff",
    "gg": "git_graph::Open"
  },
  "use_smartcase_search": true,
  "search": {
    "button": false
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "diff_view_style": "split",
  "edit_predictions": {
