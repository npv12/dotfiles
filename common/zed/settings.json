{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed"
  },
  "git": {
    "inline_blame": {}
  },
  "ui_font_family": "Inter Variable",
  "buffer_font_weight": 500.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "language_models": {
    "opencode": {
      "show_zen_models": false
    }
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",
          "openai/gpt-5.3-codex",
          "openai/gpt-5.4/medium"
        ]
      },
      "type": "registry"
    }
  },
  "agent": {
    "flexible": false,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "opencode",
      "model": "go/minimax-m2.7"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "claude-haiku-4-5",
        "enable_thinking": false
      },
      {
        "provider": "Fireworks",
        "model": "accounts/fireworks/routers/kimi-k2p5-turbo",
        "enable_thinking": false
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": true,
    "tree_view": false
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "JetBrains New UI Icons (Dark)"
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "terminal": {
    "font_family": "MesloLGS NF",
    "font_size": 14,
    "line_height": "standard"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (peach)",
    "dark": "Catppuccin Mocha (peach)"
  }
}
