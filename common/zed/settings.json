  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "github.com"
      ]
    },
    "default_profile": "write",
    "flexible": false,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "xhigh",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "go/deepseek-v4-flash"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "claude-haiku-4-5",
        "enable_thinking": false
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "sort_by": "path",
    "group_by": "staging",
    "dock": "left",
    "tree_view": false
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Warm Charmed Icons",
    "dark": "Soft Charmed Icons"
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "terminal": {
    "cursor_shape": "underline",
    "font_family": "MesloLGS NF",
    "font_size": 14,
    "line_height": "standard"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 17,
  "buffer_font_size": 16,
  "completion_menu_item_kind": "symbol",
  "theme": {
    "mode": "system",
    "light": "Sapphire Haze Light",
    "dark": "Sapphire Haze Dark"
  }
}
