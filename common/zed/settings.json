{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed"
  },
  "git": {
    "inline_blame": {}
  },
  "ui_font_family": "Inter Variable",
  "buffer_font_weight": 500.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "markdown_preview_font_family": "Inter Variable",
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font Mono",
  "language_models": {
    "opencode": {
      "show_zen_models": false
    }
  },
  "agent": {
    "default_profile": "write",
    "flexible": false,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "search_web": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "effort": "xhigh",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "go/deepseek-v4-flash"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "claude-haiku-4-5",
        "enable_thinking": false
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": true,
    "tree_view": true
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Warm Charmed Icons",
    "dark": "Soft Charmed Icons"
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "terminal": {
    "font_family": "MesloLGS NF",
    "font_size": 14,
    "line_height": "standard"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 16,
  "completion_menu_item_kind": "symbol",
  "theme": {
    "mode": "system",
    "light": "Sapphire Haze Light",
    "dark": "Sapphire Haze Dark"
  }
}
