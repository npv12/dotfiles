# Theme
font-size = 16
font-family = MesloLGS NF
# Ghostty draws shade characters (U+2591-2593) with internal gray sprites that are
# near-invisible on dark backgrounds; force the font's dotted pattern instead.
font-codepoint-map = U+2591-U+2593=MesloLGS NF

background-opacity = 0.9
background-blur = true

theme = catppuccin-mocha

bold-is-bright = true

# Cursor
custom-shader = ~/.config/ghostty/shaders/sweep.glsl
custom-shader = ~/.config/ghostty/shaders/ripple.glsl
custom-shader-animation = true

cursor-style = block
cursor-style-blink = false

# Prevent Ghostty's shell integration from changing the prompt cursor to a bar
shell-integration-features = no-cursor

# Padding
window-padding-x = 10
window-padding-y = 10

# Splits
split-divider-color = "#dc8a78"
unfocused-split-opacity = 0.7

# Quick Terminal
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-autohide = true
quick-terminal-space-behavior = remain

# Secure Input
macos-auto-secure-input = true

# Shift+Enter sends ESC CR for newline support in terminals/editors
# Works with tmux when extended-keys is enabled (csi-u format)
keybind = shift+enter=text:\n
keybind = alt+backspace=text:\x1b\x7f
